{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "sh \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/reject-powershell-syntax.sh\"",
            "statusMessage": "PowerShell 構文の混入を検査"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "if": "Write(.claude/settings.json)",
            "command": "sh \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/reject-local-paths.sh\"",
            "statusMessage": "手元固有の絶対パスの混入を検査"
          },
          {
            "type": "command",
            "shell": "bash",
            "if": "Edit(.claude/settings.json)",
            "command": "sh \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/reject-local-paths.sh\"",
            "statusMessage": "手元固有の絶対パスの混入を検査"
          }
        ]
      }
    ]
  }
}
